{
  "manifest_version": 3,
  "name": "TinyRadi",
  "version": "1.3.3",
  "description": "radiko.jp の UI を最小限にします。",
  "permissions": ["declarativeNetRequest", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://radiko.jp/*"
  ],
  "declarative_net_request": {
    "rule_resources" : [{
      "id": "ruleset",
      "enabled": true,
      "path": "ruleset.json"
    }]
  },
  "content_scripts": [
    {
      "matches": ["https://radiko.jp/"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*"],
      "matches": ["https://radiko.jp/*"]
    }
  ]
}