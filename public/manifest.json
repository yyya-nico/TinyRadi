{
  "manifest_version": 3,
  "name": "TinyRadi",
  "version": "0.0.1",
  "description": "この拡張機能を入れると、 radiko.jp が TinyRadi に置き換わります。",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "https://radiko.jp/*"
  ],
  "declarative_net_request": {
    "rule_resources" : [{
      "id": "ruleset",
      "enabled": true,
      "path": "ruleset.json"
    }]
  },
  "content_scripts": [
    {
      "matches": ["https://radiko.jp/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*"],
      "matches": ["https://radiko.jp/*"]
    }
  ]
}